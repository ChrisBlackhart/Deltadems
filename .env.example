# Copy to .env.local for local development. Never commit real values.
#
# Nothing here is required while `submitMode` is "demo" (the default during the
# build): forms validate and acknowledge honestly without sending, and log the
# row they would post. See README "Forms".

# ---------------------------------------------------------------------------
# Genesis / PostgREST  —  used when config.submitMode === "genesis"
# ---------------------------------------------------------------------------
# The project's anon key. PUBLIC BY DESIGN: in the PostgREST model the browser
# holds this key, and it is worth exactly what the grants allow — here, INSERT
# on eleven named columns of public.inquiries, with no SELECT, UPDATE or
# DELETE (see db/001-inquiries.sql). It is not a secret.
#
# Comes from the Genesis deltadems project. Not yet issued — the project has
# not been deployed to.
VITE_GENESIS_ANON_KEY=

# ---------------------------------------------------------------------------
# LEGACY  —  used only when config.submitMode === "vercel-legacy"
#
# For api/submit.js on the Vercel preview. These retire at Genesis cutover:
# outbound SMTP (25/465/587) is blocked from the Genesis droplet and Gmail has
# no alternate port, so this path cannot be carried over.
# ---------------------------------------------------------------------------

# The Gmail address the legacy endpoint sends from and to.
GMAIL_USER=

# A Gmail "App Password" for that account — NOT the account's login password.
# Requires 2-Step Verification on the account.
GMAIL_APP_PASSWORD=
