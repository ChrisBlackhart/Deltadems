# Copy this file to .env.local for local testing with `vercel dev`, and add
# the same two variables in the Vercel dashboard (Project Settings ->
# Environment Variables) for the deployed site. Never commit real values.
#
# Required for api/submit.js (contact / volunteer / newsletter forms) to
# actually deliver email. Without these, the endpoint responds with a clear
# error rather than pretending to send. See README.md "Forms & email
# delivery" for how to generate the App Password.

# The Gmail address the forms send FROM and deliver TO (DeltaDemsMI@gmail.com).
GMAIL_USER=

# A Gmail "App Password" for that account — NOT the account's normal login
# password. Requires 2-Step Verification to already be enabled on the account.
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
